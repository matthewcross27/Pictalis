# iOS — generated by XcodeGen, do not commit
# (except Package.resolved, which we pin deliberately so SPM dependency
# versions are reproducible across machines/CI and Dependabot's "swift"
# ecosystem entry has a manifest to actually scan)
ios/*.xcodeproj/*
!ios/*.xcodeproj/project.xcworkspace/
ios/*.xcodeproj/project.xcworkspace/*
!ios/*.xcodeproj/project.xcworkspace/xcshareddata/
ios/*.xcodeproj/project.xcworkspace/xcshareddata/*
!ios/*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
ios/*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/*
!ios/*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
ios/*.xcworkspace
ios/DerivedData/
*.xcuserstate
*.xcuserdatad

# macOS
.DS_Store
**/.DS_Store

# Python
worker/.venv/
worker/**/__pycache__/
worker/**/*.pyc
worker/.ruff_cache/
worker/.mypy_cache/
.pytest_cache/
.coverage

# TypeScript / Node
ranking-engine/node_modules/
backend/supabase/functions/node_modules/
ranking-engine/dist/
ranking-engine/.tsbuildinfo
npm-debug.log*
.eslintcache

# Environment — never commit secrets
.env
.env.*

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo

# Supabase
backend/supabase/.temp/
backend/supabase/functions/.cache/

# Claude Code — local dev tool state, not project artifacts
.agents/
.claude/
skills-lock.json

# iOS signing artifacts
*.p8
*.p12
*.mobileprovision

# iOS — Supabase credentials (real values only, never commit)
ios/Sources/App/SupabaseConfig.swift
